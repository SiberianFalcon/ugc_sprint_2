# ==== Kafka (общие для API и ETL) ====
APP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_KAFKA_TOPIC=events
APP_KAFKA_CLIENT_ID=ugc-api

# ==== Kafka (только ETL) ====
APP_KAFKA_GROUP_ID=ugc-etl
APP_KAFKA_DLQ_TOPIC=events.dlq

# ==== ClickHouse (только ETL) ====
APP_CLICKHOUSE_HOST=localhost
APP_CLICKHOUSE_PORT=8123
APP_CLICKHOUSE_DATABASE=ugc
APP_CLICKHOUSE_TABLE=events
APP_CLICKHOUSE_USERNAME=default
APP_CLICKHOUSE_PASSWORD=

# ==== Пакет событий (только ETL) ====
APP_BATCH_MAX_SIZE=1000
APP_BATCH_TIMEOUT_SECONDS=5.0

# ==== Мониторинг памяти (только ETL) ====
APP_MONITORING_MEMORY_THRESHOLD_MB=512
APP_MONITORING_INTERVAL_SECONDS=10.0

# ==== Повторные попытки (только ETL) ====
APP_RETRY_BACKOFF_SECONDS=5.0

# ==== HTTP-сервер (только API) ====
APP_HOST=0.0.0.0
APP_PORT=8000

# ==== Аутентификация (только API) ====
APP_AUTH_JWKS_URL=
APP_AUTH_ISSUER=auth-service
APP_AUTH_TIMEOUT_SECONDS=5.0

# ==== Наблюдаемость (только API) ====
APP_OTEL_ENABLED=false
APP_OTEL_SERVICE_NAME=ugc-api
APP_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
APP_OTEL_SAMPLE_RATIO=1.0
